DATABASE_URL=postgresql+psycopg://ccms_app:change_me@db:5432/ccms
POSTGRES_PASSWORD=change_me
SESSION_HOURS=12               # how long a sign-in lasts before the user must log in again
COOKIE_SECURE=false            # plain http on LAN. COOKIE_SECURE=true when using https (e.g. port 8443)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://localhost:8443,http://192.168.1.50:8080   # replace with your LAN IP
SEED=true
SEED_PASSWORD=Club@12345       # demo only; change for any real use
# Part B: JWT access token — MUST be changed in production (min 32 random chars)
JWT_SECRET=change_me_use_a_strong_random_32_char_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Encrypted login: set to false in production to forbid plaintext credential posting.
# When false the browser MUST use the RSA-OAEP flow (GET /auth/login-key + POST {key_id, data}).
LOGIN_ALLOW_PLAINTEXT=true
TAX_COURT=18
TAX_SHOP=18
TAX_BAR=5
TAX_MEMBERSHIP=18
